<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_ChatbotTI"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Chatbot TI" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_1" name="Atendimento de TI via chatbot Digisac" processRef="Processo_ChatbotTI" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_ChatbotTI" name="Atendimento de TI via chatbot Digisac" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_colab" name="Colaborador">
        <bpmn:flowNodeRef>ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_informar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_escolher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_seguir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_avaliar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_bot" name="Chatbot de TI (Digisac + Django)">
        <bpmn:flowNodeRef>gw_ident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pedir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_orientar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_critico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_resolveu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reg_aval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reg_solic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_horario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_transferir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fora</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_fora</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_analista" name="Analista de TI">
        <bpmn:flowNodeRef>t_atender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_encerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_analista</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ini" name="Colaborador envia mensagem no WhatsApp">
      <bpmn:documentation>Mensagem recebida pelo Digisac e enviada ao Django pelo webhook message.created.</bpmn:documentation>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw_ident" name="Colaborador já identificado?">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_pedir" name="Solicitar nome e setor">
      <bpmn:documentation>Somente no primeiro contato. Os dados ficam salvos na conversa.</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_informar" name="Informar nome e setor">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_menu" name="Apresentar menu de assuntos">
      <bpmn:documentation>Menu montado a partir das categorias ativas no Django Admin. Opção 0 = falar com analista.</bpmn:documentation>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_escolher" name="Escolher assunto e situação">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_orientar" name="Enviar orientação passo a passo">
      <bpmn:documentation>Registra a métrica 'orientação vista'.</bpmn:documentation>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_critico" name="Caso crítico de segurança?">
      <bpmn:documentation>Ex.: e-mail suspeito (phishing), perda do autenticador (MFA).</bpmn:documentation>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_seguir" name="Seguir a orientação e responder se resolveu">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_resolveu" name="Resolveu?">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_avaliar" name="Avaliar o atendimento (1 a 5)">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_reg_aval" name="Registrar avaliação e encerrar atendimento">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fim_auto" name="Resolvido no autoatendimento">
      <bpmn:incoming>f16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t_reg_solic" name="Registrar solicitação com resumo da conversa">
      <bpmn:documentation>Hoje grava no Django; no futuro abre o chamado no sistema de chamados.</bpmn:documentation>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_horario" name="Dentro do horário de atendimento?">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_transferir" name="Transferir para o departamento de TI no Digisac">
      <bpmn:documentation>O resumo vai como comentário da transferência. O bot fica em silêncio.</bpmn:documentation>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_fora" name="Informar horário da TI e encerrar">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fim_fora" name="Solicitação registrada para o próximo horário útil">
      <bpmn:incoming>f20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t_atender" name="Atender o colaborador">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_encerrar" name="Encerrar atendimento no Digisac">
      <bpmn:documentation>Ao encerrar, o bot volta a responder esse colaborador.</bpmn:documentation>
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fim_analista" name="Atendimento concluído pelo analista">
      <bpmn:incoming>f23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="ini" targetRef="gw_ident" />
    <bpmn:sequenceFlow id="f2" name="Sim" sourceRef="gw_ident" targetRef="t_menu" />
    <bpmn:sequenceFlow id="f3" name="Não" sourceRef="gw_ident" targetRef="t_pedir" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_pedir" targetRef="t_informar" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_informar" targetRef="t_menu" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_menu" targetRef="t_escolher" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_escolher" targetRef="t_orientar" />
    <bpmn:sequenceFlow id="f8" sourceRef="t_orientar" targetRef="gw_critico" />
    <bpmn:sequenceFlow id="f9" name="Não" sourceRef="gw_critico" targetRef="t_seguir" />
    <bpmn:sequenceFlow id="f10" name="Sim" sourceRef="gw_critico" targetRef="t_reg_solic" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_seguir" targetRef="gw_resolveu" />
    <bpmn:sequenceFlow id="f12" name="Sim" sourceRef="gw_resolveu" targetRef="t_avaliar" />
    <bpmn:sequenceFlow id="f13" name="Não" sourceRef="gw_resolveu" targetRef="t_reg_solic" />
    <bpmn:sequenceFlow id="f14" name="Ver outra orientação" sourceRef="gw_resolveu" targetRef="t_escolher" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_avaliar" targetRef="t_reg_aval" />
    <bpmn:sequenceFlow id="f16" sourceRef="t_reg_aval" targetRef="fim_auto" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_reg_solic" targetRef="gw_horario" />
    <bpmn:sequenceFlow id="f18" name="Sim" sourceRef="gw_horario" targetRef="t_transferir" />
    <bpmn:sequenceFlow id="f19" name="Não" sourceRef="gw_horario" targetRef="t_fora" />
    <bpmn:sequenceFlow id="f20" sourceRef="t_fora" targetRef="fim_fora" />
    <bpmn:sequenceFlow id="f21" sourceRef="t_transferir" targetRef="t_atender" />
    <bpmn:sequenceFlow id="f22" sourceRef="t_atender" targetRef="t_encerrar" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_encerrar" targetRef="fim_analista" />
  </bpmn:process>
