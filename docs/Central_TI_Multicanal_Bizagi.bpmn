<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CentralTI" targetNamespace="https://mensori.example/processos/central-ti" name="Central de Atendimento TI - Multicanal">
  <process id="Process_CentralTI" name="Atendimento de TI - Web e WhatsApp" isExecutable="false">
    <laneSet id="LaneSet_TI">
      <lane id="Lane_Colaborador" name="Colaborador">
        <flowNodeRef>Start</flowNodeRef>
        <flowNodeRef>Access</flowNodeRef>
        <flowNodeRef>Identify</flowNodeRef>
        <flowNodeRef>Describe</flowNodeRef>
        <flowNodeRef>Evaluate</flowNodeRef>
      </lane>
      <lane id="Lane_Plataforma" name="Chatbot / Plataforma de TI">
        <flowNodeRef>Available</flowNodeRef>
        <flowNodeRef>Fallback</flowNodeRef>
        <flowNodeRef>Validate</flowNodeRef>
        <flowNodeRef>Menu</flowNodeRef>
        <flowNodeRef>Critical</flowNodeRef>
        <flowNodeRef>Guide</flowNodeRef>
        <flowNodeRef>Resolved</flowNodeRef>
        <flowNodeRef>CloseAuto</flowNodeRef>
        <flowNodeRef>EndAuto</flowNodeRef>
        <flowNodeRef>Ticket</flowNodeRef>
        <flowNodeRef>Hours</flowNodeRef>
        <flowNodeRef>Queue</flowNodeRef>
        <flowNodeRef>Assign</flowNodeRef>
        <flowNodeRef>CloseHuman</flowNodeRef>
        <flowNodeRef>EndHuman</flowNodeRef>
        <flowNodeRef>EndPending</flowNodeRef>
      </lane>
      <lane id="Lane_Analista" name="Analista de TI">
        <flowNodeRef>Handle</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start" name="Início: necessidade de suporte"/>
    <userTask id="Access" name="Acessar portal por link ou WhatsApp"/>
    <exclusiveGateway id="Available" name="Canal disponível?"/>
    <serviceTask id="Fallback" name="Disponibilizar link e orientar troca de canal"/>
    <userTask id="Identify" name="Informar identificação e setor"/>
    <serviceTask id="Validate" name="Validar dados e abrir sessão"/>
    <serviceTask id="Menu" name="Apresentar categorias de TI"/>
    <userTask id="Describe" name="Selecionar assunto e descrever problema"/>
    <exclusiveGateway id="Critical" name="Incidente crítico ou segurança?"/>
    <serviceTask id="Guide" name="Consultar base e orientar passo a passo"/>
    <exclusiveGateway id="Resolved" name="Foi resolvido?"/>
    <userTask id="Evaluate" name="Avaliar atendimento (1 a 5)"/>
    <serviceTask id="CloseAuto" name="Registrar solução e encerrar"/>
    <endEvent id="EndAuto" name="Fim: resolvido"/>
    <serviceTask id="Ticket" name="Criar chamado com protocolo e resumo"/>
    <exclusiveGateway id="Hours" name="Dentro do horário de suporte?"/>
    <serviceTask id="Queue" name="Colocar na fila e informar próximo horário"/>
    <serviceTask id="Assign" name="Encaminhar chamado ao analista"/>
    <userTask id="Handle" name="Analisar e atender colaborador"/>
    <serviceTask id="CloseHuman" name="Registrar solução e encerrar chamado"/>
    <endEvent id="EndHuman" name="Fim: atendimento humano"/>
    <endEvent id="EndPending" name="Fim: chamado aguardando TI"/>
    <sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Access"/>
    <sequenceFlow id="Flow_2" sourceRef="Access" targetRef="Available"/>
    <sequenceFlow id="Flow_3" sourceRef="Available" targetRef="Identify" name="Sim"/>
    <sequenceFlow id="Flow_4" sourceRef="Available" targetRef="Fallback" name="Não"/>
    <sequenceFlow id="Flow_5" sourceRef="Fallback" targetRef="Identify"/>
    <sequenceFlow id="Flow_6" sourceRef="Identify" targetRef="Validate"/>
    <sequenceFlow id="Flow_7" sourceRef="Validate" targetRef="Menu"/>
    <sequenceFlow id="Flow_8" sourceRef="Menu" targetRef="Describe"/>
    <sequenceFlow id="Flow_9" sourceRef="Describe" targetRef="Critical"/>
    <sequenceFlow id="Flow_10" sourceRef="Critical" targetRef="Ticket" name="Sim"/>
    <sequenceFlow id="Flow_11" sourceRef="Critical" targetRef="Guide" name="Não"/>
    <sequenceFlow id="Flow_12" sourceRef="Guide" targetRef="Resolved"/>
    <sequenceFlow id="Flow_13" sourceRef="Resolved" targetRef="Evaluate" name="Sim"/>
    <sequenceFlow id="Flow_14" sourceRef="Resolved" targetRef="Ticket" name="Não"/>
    <sequenceFlow id="Flow_15" sourceRef="Evaluate" targetRef="CloseAuto"/>
    <sequenceFlow id="Flow_16" sourceRef="CloseAuto" targetRef="EndAuto"/>
    <sequenceFlow id="Flow_17" sourceRef="Ticket" targetRef="Hours"/>
    <sequenceFlow id="Flow_18" sourceRef="Hours" targetRef="Assign" name="Sim"/>
    <sequenceFlow id="Flow_19" sourceRef="Hours" targetRef="Queue" name="Não"/>
    <sequenceFlow id="Flow_20" sourceRef="Queue" targetRef="EndPending"/>
    <sequenceFlow id="Flow_21" sourceRef="Assign" targetRef="Handle"/>
    <sequenceFlow id="Flow_22" sourceRef="Handle" targetRef="CloseHuman"/>
    <sequenceFlow id="Flow_23" sourceRef="CloseHuman" targetRef="EndHuman"/>
  </process>
