        <flowNodeRef>T13</flowNodeRef>
        <flowNodeRef>G6</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="S" name="Projeto instalado ou alterado">
      <outgoing>f1</outgoing>
    </startEvent>
    <userTask id="T1" name="Executar a suíte de testes (manage.py test apps)">
      <incoming>f1</incoming>
      <incoming>f22</incoming>
      <outgoing>f2</outgoing>
    </userTask>
    <serviceTask id="T2" name="Criar o banco de teste (SQLite)">
      <incoming>f2</incoming>
      <outgoing>f3</outgoing>
    </serviceTask>
    <parallelGateway id="G1" name="">
      <incoming>f3</incoming>
      <outgoing>f4</outgoing>
      <outgoing>f5</outgoing>
      <outgoing>f6</outgoing>
      <outgoing>f7</outgoing>
      <outgoing>f8</outgoing>
    </parallelGateway>
    <serviceTask id="P1" name="Testar o motor da conversa (25 testes)">
      <incoming>f4</incoming>
      <outgoing>f9</outgoing>
    </serviceTask>
    <serviceTask id="P2" name="Testar o orquestrador (11 testes)">
      <incoming>f5</incoming>
      <outgoing>f10</outgoing>
    </serviceTask>
    <serviceTask id="P3" name="Testar o portal web (7 testes)">
      <incoming>f6</incoming>
      <outgoing>f11</outgoing>
    </serviceTask>
    <serviceTask id="P4" name="Testar o painel de TI (4 testes)">
      <incoming>f7</incoming>
      <outgoing>f12</outgoing>
    </serviceTask>
    <serviceTask id="P5" name="Testar WhatsApp / Digisac (8 testes)">
      <incoming>f8</incoming>
      <outgoing>f13</outgoing>
    </serviceTask>
    <parallelGateway id="G2" name="">
      <incoming>f9</incoming>
      <incoming>f10</incoming>
      <incoming>f11</incoming>
      <incoming>f12</incoming>
      <incoming>f13</incoming>
      <outgoing>f14</outgoing>
    </parallelGateway>
    <serviceTask id="T8" name="Destruir o banco de teste e gerar o resultado">
      <incoming>f14</incoming>
      <outgoing>f15</outgoing>
    </serviceTask>
    <exclusiveGateway id="G3" name="Todos os testes aprovados?">
      <incoming>f15</incoming>
      <outgoing>f16</outgoing>
      <outgoing>f23</outgoing>
    </exclusiveGateway>
    <userTask id="T9" name="Analisar o erro e identificar a causa">
      <incoming>f16</incoming>
      <incoming>f26</incoming>
      <outgoing>f17</outgoing>
    </userTask>
    <exclusiveGateway id="G4" name="Onde está a causa?">
      <incoming>f17</incoming>
      <outgoing>f18</outgoing>
      <outgoing>f19</outgoing>
    </exclusiveGateway>
    <userTask id="T10" name="Corrigir o teste">
      <incoming>f18</incoming>
      <outgoing>f20</outgoing>
    </userTask>
    <userTask id="T11" name="Corrigir o código do sistema">
      <incoming>f19</incoming>
      <outgoing>f21</outgoing>
    </userTask>
    <exclusiveGateway id="G5" name="">
      <incoming>f20</incoming>
      <incoming>f21</incoming>
      <outgoing>f22</outgoing>
    </exclusiveGateway>
    <serviceTask id="T12" name="Testar o chat de ponta a ponta pelo HTTP">
      <incoming>f23</incoming>
      <outgoing>f24</outgoing>
    </serviceTask>
    <serviceTask id="T13" name="Testar o painel (login, fila, detalhe, arquivos estáticos)">
      <incoming>f24</incoming>
      <outgoing>f25</outgoing>
    </serviceTask>
    <exclusiveGateway id="G6" name="Respondeu como esperado?">
      <incoming>f25</incoming>
      <outgoing>f26</outgoing>
      <outgoing>f27</outgoing>
    </exclusiveGateway>
    <userTask id="T14" name="Rodar a execução final detalhada (-v 2)">
      <incoming>f27</incoming>
      <outgoing>f28</outgoing>
    </userTask>
    <userTask id="T15" name="Registrar o diário de testes e o log">
      <incoming>f28</incoming>
      <outgoing>f29</outgoing>
    </userTask>
    <userTask id="T16" name="Conferir os critérios de aceite">
      <incoming>f29</incoming>
      <outgoing>f30</outgoing>
    </userTask>
    <endEvent id="E" name="Diário de testes concluído">
      <incoming>f30</incoming>
    </endEvent>
