  <process id="Proc_DiarioTestes" name="Diário de testes" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="Lane_Dev" name="Desenvolvedor">
        <flowNodeRef>S</flowNodeRef>
        <flowNodeRef>T1</flowNodeRef>
