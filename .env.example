# Modelo do arquivo de configuração. Copie para .env e preencha:
#   Copy-Item .env.example .env
# O .env guarda os segredos e NUNCA vai para o Git (está no .gitignore).
# Não coloque valores reais neste arquivo.

# --- Django ---
# Obrigatória. Gere uma com:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# true só no seu computador. Em produção (HTTPS) use false: os cookies passam a ser só HTTPS.
DJANGO_DEBUG=true
# Para testar com o ngrok, acrescente o domínio dele, ex.: localhost,127.0.0.1,.ngrok-free.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Com https, informe a origem completa, ex.: https://ti.suaempresa.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# --- Servidor em segundo plano (servir.py / instalar_servico.ps1) ---
# 127.0.0.1 = só este computador. 0.0.0.0 = outros computadores da rede também acessam
# (aí inclua o IP ou nome desta máquina em DJANGO_ALLOWED_HOSTS e libere a porta no firewall).
SERVIDOR_HOST=127.0.0.1
SERVIDOR_PORTA=8000

# --- Banco (deixe DB_NAME vazio para usar SQLite) ---
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Central de TI (portal web: canal principal) ---
CENTRAL_NOME=Central de TI
# Campos pedidos ao colaborador, na ordem (opções: nome, setor, centro_custo, email, matricula)
CENTRAL_IDENTIFICACAO=nome,setor,centro_custo,email
# Domínios aceitos no e-mail corporativo, separados por vírgula (vazio = qualquer domínio)
CENTRAL_DOMINIOS_EMAIL=
CENTRAL_LIMITE_MENSAGENS_MINUTO=20

# --- Horário de atendimento humano (0=segunda ... 6=domingo) ---
BOT_HORARIO_DIAS=0,1,2,3,4
BOT_HORARIO_INICIO=08:00
BOT_HORARIO_FIM=18:00
BOT_TEXTO_HORARIO=segunda a sexta, das 8h às 18h
# Minutos sem resposta até o atendimento recomeçar (mantém a identificação)
BOT_TIMEOUT_MINUTOS=30
# Horas que a pesquisa de satisfação (enviada ao resolver o chamado) espera a resposta
BOT_PESQUISA_HORAS=72

# --- SLA dos chamados (horas úteis, dentro do horário acima) ---
# O SLA de cada categoria fica no Admin > Categorias. Este vale para chamado sem categoria.
SLA_PADRAO_HORAS=72

# --- WhatsApp via Digisac (opcional; desligado não afeta o portal) ---
WHATSAPP_ATIVO=false
# Endereço da sua conta, ex.: https://suaempresa.digisac.app
DIGISAC_URL=
# Digisac > Conta > API > Tokens de acesso pessoal
DIGISAC_TOKEN=
# ID da conexão de WhatsApp usada pelo bot (opcional)
DIGISAC_SERVICE_ID=
# ID do departamento (fila) da TI para onde o bot transfere (opcional)
DIGISAC_DEPARTAMENTO_TI_ID=
# Segredo que vai na URL do webhook (/webhooks/digisac/?token=...). Gere com:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
DIGISAC_WEBHOOK_TOKEN=
# false = não envia nada ao Digisac, só registra no log (bom para testar)
DIGISAC_ENVIAR_MENSAGENS=false
DIGISAC_TIMEOUT_SEGUNDOS=10

# --- Sistema de chamados externo (opcional) ---
CHAMADOS_BACKEND=apps.chamados.backends.BackendLocal
