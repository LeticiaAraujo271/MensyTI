# Copie para .env e ajuste. Segredos ficam SÓ aqui (o .env não vai para o controle de versão).

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ti.suaempresa.com.br
# Em produção (HTTPS), deixe DJANGO_DEBUG=false: os cookies passam a ser só HTTPS.

# --- Banco (deixe DB_NAME vazio para usar SQLite) ---
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Central de TI (portal web: canal principal) ---
CENTRAL_NOME=Central de TI
# Campos pedidos ao colaborador, na ordem (opções: nome, setor, email, matricula)
CENTRAL_IDENTIFICACAO=nome,setor,email
# Domínios aceitos no e-mail corporativo, separados por vírgula (vazio = qualquer domínio)
CENTRAL_DOMINIOS_EMAIL=
CENTRAL_LIMITE_MENSAGENS_MINUTO=20

# --- Horário de atendimento humano (0=segunda ... 6=domingo) ---
BOT_HORARIO_DIAS=0,1,2,3,4
BOT_HORARIO_INICIO=08:00
BOT_HORARIO_FIM=18:00
BOT_TEXTO_HORARIO=segunda a sexta, das 8h às 18h
# Minutos sem resposta até o atendimento recomeçar (mantém a identificação)
BOT_TIMEOUT_MINUTOS=30

# --- WhatsApp via Digisac (opcional; desligado não afeta o portal) ---
WHATSAPP_ATIVO=false
DIGISAC_URL=https://suaempresa.digisac.app
DIGISAC_TOKEN=cole-aqui-o-token-pessoal
DIGISAC_SERVICE_ID=
DIGISAC_WEBHOOK_TOKEN=gere-um-segredo-aleatorio
# false = não envia nada ao Digisac, só registra no log
DIGISAC_ENVIAR_MENSAGENS=false

# --- Sistema de chamados externo (opcional) ---
CHAMADOS_BACKEND=apps.chamados.backends.BackendLocal
